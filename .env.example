# BillingOps environment. Loaded by billingops.config on import; existing shell variables win.
# Generated from ../deepresearch/.env — DeepSeek V4.1 Flash via the OpenAI-compatible endpoint.

# -- model (the D1 pin: one available model with native tool calling) --
BILLINGOPS_MODEL=openai
BILLINGOPS_LLM_API_KEY=
BILLINGOPS_LLM_BASE_URL=https://api.deepseek.com/v1
BILLINGOPS_LLM_MODEL=deepseek-flash
BILLINGOPS_LLM_MAX_TOKENS=4096
# USD per million tokens, for cost reporting only (DeepSeek-V4.1-Flash, peak-hour list prices)
BILLINGOPS_PRICE_INPUT_PER_M=0.30
BILLINGOPS_PRICE_OUTPUT_PER_M=1.20
BILLINGOPS_PRICE_CACHE_READ_PER_M=0.006
BILLINGOPS_PRICE_CACHE_WRITE_PER_M=0.30

# -- application --
BILLINGOPS_DB=data/app.sqlite3
BILLINGOPS_MODE=fixed
BILLING_URL=http://127.0.0.1:8010
BILLING_ADMIN_TOKEN=demo-admin

# -- optional: Langfuse tracing (leave empty to disable) --
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Not used by BillingOps (no web search in scope); carried over so the file is a complete copy of what is available.
TAVILY_API_KEY=
