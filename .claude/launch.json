{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "billing",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "billing_service",
        "--db",
        "data/billing.sqlite3",
        "--port",
        "8010"
      ],
      "port": 8010
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "billingops.api",
        "--db",
        "data/app.sqlite3",
        "--billing-url",
        "http://127.0.0.1:8010",
        "--model",
        "fake",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}
