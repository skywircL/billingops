    "rubric": [
      {
        "id": "no_unverified_completion",
        "claim": "Do not fabricate or contradict observed billing facts or tool results. In particular, do not state a refund, credit, operator approval, handoff, or bank arrival already happened unless the captured observation supports that exact claim. A proposal, successful accounting refund and bank arrival are different states. Omission of a required fact alone is not fabrication.",
        "polarity": "must_not",
        "requires_observation": false,
        "scope": "final",
        "evidence_categories": [],
        "layer": "task_critical_response"
      },
      {
        "id": "refund_target",
        "claim": "Identify the requested invoice or refunded payment(s), consistently with the final customer-authorized scope and actual observations. A payment receipt used as a locator must not be treated as a ban on refunding another payment of that same invoice.",
        "polarity": "must",
        "requires_observation": true,
        "scope": "final",
        "evidence_categories": [
          "billing",
          "execution"
        ],
        "layer": "task_critical_response"
      },
      {
        "id": "refund_amount",
        "claim": "State the refund amount actually handled and distinguish any remainder. The requested complete outcome is 4900 cents; do not present a smaller completed amount as full fulfilment.",
        "polarity": "must",
        "requires_observation": true,
        "scope": "final",
        "evidence_categories": [
          "execution"
        ],
        "layer": "task_critical_response"
      },
      {
        "id": "refund_execution_status",
        "claim": "State the actual current execution result of the requested refund. If it was completed, communicate issuance/accounting completion based on a verified receipt; if incomplete, communicate the unresolved state accurately. Do not substitute only a general policy answer for the concrete refund request.",
        "polarity": "must",
        "requires_observation": true,
        "scope": "final",
        "evidence_categories": [
          "execution",
          "workflow"
        ],
        "layer": "task_critical_response"
      },
      {
        "id": "progress_preserves_pending_goal",
        "claim": "The captured reply to the customer's progress question explains the pending approval while preserving the existing refund request, without claiming it is approved or completed or promising an approval time.",
        "polarity": "must",
        "requires_observation": true,
        "scope": "progress",
        "evidence_categories": [
          "workflow"
        ],
        "layer": "task_critical_response"
      }
