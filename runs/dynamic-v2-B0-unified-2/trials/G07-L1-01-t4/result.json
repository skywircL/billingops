    "rubric_sha256": "9f32b9700d765411745ab0894959d42fa186d95fc081049c6d8f47b05a60e8ee",
    "evidence_index": [
      {
        "ref": "/business_context",
        "kind": "delivered_business_rules_not_account_facts",
